[
  {
    "id": "claude-code",
    "name": "Claude Code",
    "files": [
      {
        "path": "~/.claude/settings.json",
        "content": "{\n  \"hooks\": {\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"'/__AGENTCUE_EXECUTABLE__' '--tool-hook' 'claude-code'\",\n            \"timeout\": 10\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"'/__AGENTCUE_EXECUTABLE__' '--tool-hook' 'claude-code'\",\n            \"timeout\": 10\n          }\n        ]\n      }\n    ],\n    \"Notification\": [\n      {\n        \"matcher\": \"permission_prompt\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"'/__AGENTCUE_EXECUTABLE__' '--tool-hook' 'claude-code'\",\n            \"timeout\": 10\n          }\n        ]\n      }\n    ]\n  }\n}"
      }
    ],
    "steps": [
      "保持 AgentCue 桌面应用运行，并开启本地来源读取；被忽略的工具不接收任务事件。",
      "配置由你粘贴；保留已有设置、Hooks 和脚本，不覆盖其他逻辑。",
      "配置后发送一个新任务，观察下方最近事件时间；收到开始或结束后才表示任务播报已接入。",
      "将 hooks 合并进用户级 ~/.claude/settings.json；保留已有事件与 matcher，不要覆盖其他 Hooks。",
      "重新打开 Claude Code 会话后发送一个新任务；会话身份取自 transcript 路径，与文件采集一致。"
    ],
    "commandReady": false,
    "lastEventAt": null,
    "enabled": true,
    "capabilityReason": "开始与完成来自 UserPromptSubmit / Stop；Notification 的 permission_prompt 视为等待确认。批准本身只通过之后的开始或完成事件间接观察。"
  },
  {
    "id": "cursor",
    "name": "Cursor",
    "files": [
      {
        "path": "~/.cursor/hooks.json",
        "content": "{\n  \"version\": 1,\n  \"hooks\": {\n    \"beforeSubmitPrompt\": [\n      {\n        \"command\": \"'/__AGENTCUE_EXECUTABLE__' '--tool-hook' 'cursor'\",\n        \"type\": \"command\",\n        \"timeout\": 3,\n        \"failClosed\": false\n      }\n    ],\n    \"preToolUse\": [\n      {\n        \"command\": \"'/__AGENTCUE_EXECUTABLE__' '--tool-hook' 'cursor'\",\n        \"type\": \"command\",\n        \"timeout\": 3,\n        \"failClosed\": false\n      }\n    ],\n    \"stop\": [\n      {\n        \"command\": \"'/__AGENTCUE_EXECUTABLE__' '--tool-hook' 'cursor'\",\n        \"type\": \"command\",\n        \"timeout\": 3,\n        \"failClosed\": false\n      }\n    ]\n  }\n}"
      }
    ],
    "steps": [
      "保持 AgentCue 桌面应用运行，并开启本地来源读取；被忽略的工具不接收任务事件。",
      "配置由你粘贴；保留已有设置、Hooks 和脚本，不覆盖其他逻辑。",
      "配置后发送一个新任务，观察下方最近事件时间；收到开始或结束后才表示任务播报已接入。",
      "合并 hooks.json 后，重新加载 Cursor 窗口；适用于自带 Agent / 聊天。"
    ],
    "commandReady": false,
    "lastEventAt": null,
    "enabled": true,
    "capabilityReason": "开始与结束来自 beforeSubmitPrompt / stop；Agent 弹出提问框时 preToolUse 携带 AskQuestion 工具，据此播报待确认。"
  },
