# 让 native 模块（better-sqlite3）与 Electron 的 node_modules 布局更兼容
node-linker=hoisted
auto-install-peers=true
strict-peer-dependencies=false
# better-sqlite3 / electron 等需要执行 postinstall 脚本
enable-pre-post-scripts=true
# Electron 二进制下载走 npmmirror（GitHub 直连被墙）
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
# better-sqlite3 预编译产物镜像；下载失败时 @electron/rebuild 会退回 node-gyp 本地编译
better_sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/better-sqlite3
