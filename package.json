{
  "name": "ai-workflow-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "AgentCue：本地优先的 AI 编码工具任务监控与语音提醒",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ideshun/AgentCue.git"
  },
  "bugs": "https://github.com/ideshun/AgentCue/issues",
  "homepage": "https://github.com/ideshun/AgentCue#readme",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "pretypecheck": "pnpm -r run build",
    "test": "node scripts/run-tests.mjs run",
    "test:watch": "node scripts/run-tests.mjs watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "pnpm --filter @awm/desktop run dev",
    "dist": "pnpm --filter @awm/desktop run dist",
    "release:verify": "node scripts/verify-package.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:checksums": "node scripts/release.mjs checksums",
    "rebuild:native": "pnpm --filter @awm/store run rebuild",
    "adapter:validate": "pnpm --filter @awm/adapters exec node dist/validate-cli.js",
    "latency-report": "node scripts/run-tests.mjs run tests/perf/latency-report.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  }
}
